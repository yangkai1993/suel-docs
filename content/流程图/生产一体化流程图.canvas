{
	"nodes":[
		{"id":"sale_contract","type":"text","text":"## 📋 销售合同\n[[02-销售部操作指南]]\n合同确认后\n→ 转预生产计划","x":-440,"y":-640,"width":280,"height":140,"color":"1"},
		{"id":"tech_bom","type":"text","text":"## 🔧 技术部\n[[03-技术部操作指南]]\n提供工艺流程 + BOM\n→ 供生产计划引用","x":0,"y":-640,"width":280,"height":140,"color":"6"},
		{"id":"pre_plan","type":"text","text":"## 📝 预生产计划\n销售合同自动转入\n或手动添加","x":-440,"y":-440,"width":280,"height":120,"color":"4"},
		{"id":"prod_plan","type":"text","text":"## 📝 生产计划\n选择BOM引用\n保存后自动提示物料分析","x":-440,"y":-260,"width":280,"height":120,"color":"4"},
		{"id":"mat_analysis","type":"text","text":"## 📊 物料分析\n库存不足→显示应自制/采购数量\n库存充足→数量为0","x":-440,"y":-80,"width":300,"height":120,"color":"4"},
		{"id":"prod_order","type":"text","text":"## 📄 生产订单\n物料分析完成后\n点击「生产订单」生成","x":-440,"y":100,"width":280,"height":120,"color":"4"},
		{"id":"dispatch","type":"text","text":"## 🏭 生产派工\n选择人员、车间、批号\n→ 确认派工单","x":-440,"y":280,"width":280,"height":120,"color":"5"},
		{"id":"branch","type":"text","text":"## ◇ 派工方式\n选择自制或委外","x":-440,"y":460,"width":240,"height":100,"color":"5"},
		{"id":"self_dispatch","type":"text","text":"## 自制派工\n领料→库管确认→工序执行","x":-760,"y":600,"width":280,"height":80,"color":"5"},
		{"id":"outsource_dispatch","type":"text","text":"## 整单委外\n可选是否领料","x":20,"y":600,"width":240,"height":80,"color":"5"},
		{"id":"pick_material","type":"text","text":"## 📦 领料\n[[07-库房操作指南]]\n派工详情→领料→库管确认出库","x":-760,"y":760,"width":280,"height":120,"color":"2"},
		{"id":"outsource_recv","type":"text","text":"## 📥 委外收货\n可设自动送检","x":20,"y":760,"width":240,"height":80,"color":"5"},
		{"id":"process_exec","type":"text","text":"## ⚙️ 工序执行\n一道一道工序汇报\n选择生产人员，保存汇报完成","x":-760,"y":940,"width":280,"height":120,"color":"5"},
		{"id":"mat_register","type":"text","text":"## 📝 物料登记\n异常时手动登记\n（忘领/退料/废料）","x":-1160,"y":940,"width":240,"height":120,"color":"6"},
		{"id":"direct_pick","type":"text","text":"## 直接领料\n低值易耗品 / 不在BOM中","x":-1160,"y":760,"width":240,"height":80,"color":"6"},
		{"id":"process_outsource","type":"text","text":"## 工序委外\n某工序委托外部加工","x":-1160,"y":1100,"width":240,"height":80,"color":"6"},
		{"id":"qc_dispatch","type":"text","text":"## ✅ 派工质检\n[[06-质检部操作指南]]\n工序汇报后送检\n质检合格→入库申请","x":-440,"y":1120,"width":280,"height":140,"color":"3"},
		{"id":"qc_outsource","type":"text","text":"## ✅ 委外质检\n[[06-质检部操作指南]]\n整单：质检后入库\n工序：继续下一道","x":20,"y":940,"width":260,"height":160,"color":"3"},
		{"id":"warehouse_in","type":"text","text":"## 📦 生产入库\n[[07-库房操作指南]]\n质检合格→入库\n无需质检→直接入库","x":-440,"y":1320,"width":280,"height":140,"color":"2"},
		{"id":"mat_return","type":"text","text":"## 退料\n换料/剩料退回","x":-1160,"y":1260,"width":200,"height":80,"color":"6"},
		{"id":"mat_scrap","type":"text","text":"## 废料\n需入库→成本计入原材料\n无需入库→月底分摊","x":-1160,"y":1400,"width":280,"height":120,"color":"6"},
		{"id":"sale_out","type":"text","text":"## 📤 销售出库\n[[02-销售部操作指南]]\n库房确认出库","x":-440,"y":1520,"width":280,"height":120,"color":"2"},
		{"id":"after_sale","type":"text","text":"## 🔧 售后维修\n[[09-售后部操作指南]]\n仅销售出库产品可维修","x":-840,"y":1520,"width":260,"height":120,"color":"6"},
