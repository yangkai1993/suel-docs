		{"id":"wage","type":"text","text":"## 💰 计件工资\n[[05-生产部操作指南]]\n确定工价→生成计件工资","x":60,"y":1320,"width":260,"height":140,"color":"6"},
		{"id":"finance","type":"text","text":"## 💰 财务关联\n[[08-财务部操作指南]]\n收付款 / 开收票 / 成本核算","x":60,"y":1520,"width":280,"height":120,"color":"6"},
